test_mode = false
platform = "asuswrt"

[server]
bind = "0.0.0.0"
port = 3030
auth_token = "__AUTH_TOKEN__"
allowed_origins = ["http://127.0.0.1:8080", "https://127.0.0.1:8443", "http://127.0.0.1:3030"]

[paths]
wireguard_conf = "/opt/etc/wireguard/wgs1.conf"

[commands]
service = "/usr/local/libexec/router-lab/service"
logread = "/usr/local/libexec/router-lab/logread"
openssl = "__OPENSSL_BIN__"
wg = "/opt/bin/wg"
wg_quick = "/opt/bin/wg-quick"
ip = "__IP_BIN__"

[asus_ui]
enabled = true
rendered_page = "/tmp/var/wwwext/user20.asp"
menu_tree = "/www/require/modules/menuTree.js"
menu_index = "menu_Alexa_IFTTT"
api_base_url = ""

[adguard]
enabled = false
lan_ip = ""
