#!/bin/sh
case "$1" in
  status) echo "demo service is running"; exit 0 ;;
  start) echo "demo service started" ;;
  stop) echo "demo service stopped" ;;
  restart) echo "demo service restarted" ;;
  reconfigure) echo "demo service reconfigured" ;;
  enable) echo "demo service enabled; start it explicitly when ready" ;;
  disable) echo "demo service disabled" ;;
  *) echo "usage: $0 {start|stop|restart|reconfigure|status}"; exit 1 ;;
esac
