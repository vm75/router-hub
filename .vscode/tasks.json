{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Router Hub",
            "type": "process",
            "command": "cargo",
            "args": [
                "build",
                "--bin",
                "router-hub"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$rustc"
            ]
        }
    ]
}
