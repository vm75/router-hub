#!/bin/sh

ENABLED=yes
PROCS=router-hub
ARGS=""
PREARGS=""
DESC=$PROCS
PATH=/opt/sbin:/opt/bin:/opt/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

if [ "${1:-}" = "reconcile" ]; then
    PID="$(pidof "$PROCS" 2>/dev/null || true)"
    [ -n "$PID" ] || exit 1
    for process_id in $PID; do
        kill -USR1 "$process_id"
    done
    exit 0
fi

if [ "${1:-}" = "disable" ]; then
    DISABLED_PATH="$(dirname "$0")/.disabled.$(basename "$0")"
    [ -e "$DISABLED_PATH" ] && exit 1
    "$0" stop >/dev/null 2>&1 || true
    [ -n "$(pidof "$PROCS" 2>/dev/null)" ] && exit 1
    mv "$0" "$DISABLED_PATH"
    exit 0
fi

. /opt/etc/init.d/rc.func
